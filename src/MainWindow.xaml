<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="每日一记吧" Width="460" Height="430" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
  <Grid Margin="22,16,22,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Height="24" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PoemLabel" FontFamily="KaiTi" FontSize="14" Foreground="#72819A" VerticalAlignment="Center"/>
      <Button x:Name="HistoryButton" Grid.Column="1" Content="历史记录" Style="{DynamicResource QuietButton}" Padding="5,3" FontSize="11"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,16" Height="70">
      <StackPanel>
        <TextBlock x:Name="DateLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
        <TextBlock x:Name="QuestionLabel" Text="今天，过得怎么样？" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="两三句话就好，小事和心情都可以。" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
      </StackPanel>
      <Canvas Width="90" Height="70" HorizontalAlignment="Right" IsHitTestVisible="False">
        <Ellipse Width="74" Height="66" Canvas.Left="8" Canvas.Top="0">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#55E6DEC4" Offset="0"/><GradientStop Color="#00E6DEC4" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Path Data="M 64,6 C 39,0 27,18 35,37 C 41,51 61,54 73,39 C 54,44 45,32 47,21 C 49,13 55,8 64,6 Z" Stroke="#DACDAF" StrokeThickness="0.6">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F5DDA9" Offset="0"/><GradientStop Color="#E8DCBD" Offset="1"/></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M 13,14 L 15,19 L 20,21 L 15,23 L 13,28 L 11,23 L 6,21 L 11,19 Z" Fill="#BCC8DD"/>
        <Ellipse Width="3" Height="3" Fill="#B8C5DB" Canvas.Left="79" Canvas.Top="15"/>
        <Ellipse Width="2" Height="2" Fill="#C9D2E1" Canvas.Left="25" Canvas.Top="4"/>
        <Path Data="M 20,57 C 20,51 26,48 32,51 C 33,40 48,40 51,49 C 58,44 67,49 66,56 C 75,54 78,62 70,64 L 26,64 C 20,64 16,60 20,57 Z" Fill="#E4EBF4"/>
        <Path Data="M 2,53 C 5,49 11,49 14,53 L 23,53 C 28,53 28,57 23,57 L 6,57 C 1,57 0,55 2,53 Z" Fill="#EDF1F7"/>
      </Canvas>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <TextBox x:Name="SummaryInput" Style="{DynamicResource Input}" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="600"/>
      </Grid>
      <Grid Grid.Row="1" Height="15" Margin="0,7,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="EntryHint" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Counter" Grid.Column="1" Foreground="#9AA5B5" FontSize="10" Margin="8,0,0,0"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="3">
      <Border x:Name="CountdownPanel" Height="52" Visibility="Collapsed" Background="#E8EEF7" CornerRadius="12" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CountdownTitle" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="今天的小记已经收好。" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0"/>
          </StackPanel>
          <Button x:Name="CancelShutdownButton" Grid.Column="1" Content="取消关机" Style="{DynamicResource SecondaryButton}" Padding="11,6" FontSize="11"/>
        </Grid>
      </Border>
      <Grid x:Name="ActionPanel" Height="52">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="SaveOnlyButton" Content="只保存" Height="40" Style="{DynamicResource SecondaryButton}"/>
        <Button x:Name="SaveShutdownButton" Grid.Column="2" Content="保存并关机" Height="40" Style="{DynamicResource PrimaryButton}" ToolTip="Ctrl + Enter 保存并关机；关机前有 10 秒可取消"/>
      </Grid>
      <ScrollViewer Height="29" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="StatusLabel" Text="" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
      </ScrollViewer>
    </StackPanel>
    <TextBlock Grid.Row="5" Text="把今天放好，晚安。" Foreground="#99A5B7" FontSize="10.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
  </Grid>
</Window>
